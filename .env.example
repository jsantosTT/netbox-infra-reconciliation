# nbrecon runtime configuration.
#
# Copy to .env on the management host, fill in, then lock it down:
#     cp .env.example .env && chmod 600 .env
#
# .env is gitignored and must never be baked into the container image.
# Mount it at runtime instead:  docker run --env-file .env ...

# --- NetBox -----------------------------------------------------------------
NBRECON_NETBOX_URL=https://netbox.it.aws.tenstorrent.com
NBRECON_NETBOX_TOKEN=
# TLS verification is forced on for NetBox and cannot be disabled.

# --- Jira (IPT tickets) -----------------------------------------------------
NBRECON_JIRA_URL=https://tenstorrent.atlassian.net
NBRECON_JIRA_USER=
NBRECON_JIRA_TOKEN=
NBRECON_JIRA_PROJECT_KEY=IPT
# Jira custom field IDs for the SN and NetBox URL fields on an IPT issue.
# Leave blank until Dev Infra confirms them; blank disables those writes.
NBRECON_JIRA_FIELD_SERIAL=
NBRECON_JIRA_FIELD_NETBOX_URL=

# --- Metrics (node names only in v1) ----------------------------------------
# Either point straight at Prometheus, or go through the Grafana datasource
# proxy when Prometheus is not directly reachable.
NBRECON_PROMETHEUS_URL=
NBRECON_GRAFANA_URL=https://grafana.it.aws.tenstorrent.com
NBRECON_GRAFANA_TOKEN=
NBRECON_GRAFANA_DATASOURCE_UID=

# --- BMC / Redfish ----------------------------------------------------------
NBRECON_BMC_USER=
NBRECON_BMC_PASSWORD=
# Lab BMCs ship self-signed certs. Setting this to false is permitted ONLY for
# lab sites and emits a warning on every run. It never affects NetBox/Jira/Grafana.
NBRECON_BMC_VERIFY_TLS=true
NBRECON_BMC_TIMEOUT=20

# --- Run behaviour ----------------------------------------------------------
# Hard cap on devices touched by a single apply run during the pilot.
NBRECON_MAX_BATCH=20
NBRECON_ARTIFACT_DIR=var/runs
NBRECON_RUN_HISTORY_DB=var/run-history.db
